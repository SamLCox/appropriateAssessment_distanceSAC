## create map of distance to SAC - otter

## create base grid
baseGrid <- raster(xmn = min(mapLimitsX),
                   xmx = max(mapLimitsX),
                   ymn = min(mapLimitsY),
                   ymx = max(mapLimitsY),
                   crs = "+proj=longlat +datum=WGS84 +ellps=WGS84")
baseGrid <- projectRaster(baseGrid, crs = "+proj=utm +zone=29 +datum=WGS84 +units=m +no_defs")
res(baseGrid) <- 500
baseGrid <- projectRaster(baseGrid, crs = "+proj=longlat +datum=WGS84 +ellps=WGS84")
values(baseGrid) <- 0

## mark points that are within an SAC (with 4)
cell_ID <- NA
siteCodesRef <- siteCodes[which(siteCodes$species == 'otter'), ]

for(II in 1:nrow(siteCodesRef)){
  dataTemp <- sacs %>% dplyr::filter(SITECODE == siteCodesRef$sitecodes[II])
  dataTemp <- as_Spatial(dataTemp$geom)
  
  cell_ID <- c(cell_ID, unname(raster::extract(baseGrid, dataTemp, cellnumbers = TRUE)[[1]][, 1]))
  
  rm(dataTemp)
}
rm(II)

cell_ID <- cell_ID[-1]
baseGrid[cell_ID] <- 4

# plot(baseGrid)

## identify points outwith within EEZ (overriding SAC allocations if they are on land)
baseGrid <- raster::mask(baseGrid, irelandEEZ_pg, inverse = FALSE) ## if you get an error about extents try restarting R.
baseGrid@data@values[is.na(baseGrid@data@values) == 1] <- 2
# plot(baseGrid)

## calculate distances to SAC's
distance_sac <- gridDistance(baseGrid, origin = 4, omit = 2)/1000
distance_sac <- as.data.frame(distance_sac, xy = TRUE)
distance_sac <- distance_sac[which(is.na(distance_sac$layer) == 0), ]

## plot out
plotOut <- ggplot(distance_sac, aes(x, y, fill = layer)) +
  geom_polygon(data = coastLine_df, aes(x = long, y = lat, group = group), color = 'grey42', fill = "grey84") +
  geom_tile() +
  
  xlab("longitude") +
  ylab("latitude") +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  
  scale_fill_viridis(name = "distance (km)", direction = 1, option = "D", discrete = FALSE,
                     trans = "pseudo_log",
                     guide = guide_colourbar(title.position = "top", barwidth = 1, barheight = 14),
                     breaks = c(0, 1, 5, 10, 50, 100, 200, 400)) +
  
  theme(axis.title = element_text(size = 12),
        axis.text = element_text(size = 10),
        legend.text = element_text(size = 10),
        panel.background = element_blank(),
        panel.grid = element_blank(),
        panel.border = element_rect(colour = "grey42", fill = NA, size = 1)) +
  
  coord_sf(xlim = mapLimitsX, ylim = mapLimitsY, crs = 4326) +
  annotation_scale(location = "br", width_hint = 0.5, unit_category = "metric") +
  ggtitle('')

